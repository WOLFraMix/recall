# Recall — конфигурация. Скопируйте в .env и поправьте под себя:
#   cp .env.example .env

# Адрес HTTP-сервера (REST, SSE и веб-интерфейс)
RC_LISTEN=:8080

# Файл SQLite: документы, чанки, векторы
RC_DB_PATH=./data/recall.db

# URL провайдера моделей (Ollama)
RC_LLM_URL=http://localhost:11434

# Модель эмбеддингов. Мультиязычная (100+ языков), 1024 измерения.
# НЕ меняйте её у существующей базы — векторы несовместимы, нужен реиндекс.
RC_EMBED_MODEL=bge-m3

# Чат-модель (генерация ответов)
RC_CHAT_MODEL=qwen2.5-coder:7b

# Чанкинг: размер чанка и перекрытие соседей, в символах
RC_CHUNK_SIZE=800
RC_CHUNK_OVERLAP=100

# Сколько фрагментов отдавать модели в контекст
RC_TOP_K=5

# Пул обработки загрузок: воркеры и ёмкость очереди (backpressure)
RC_INGEST_WORKERS=4
RC_QUEUE_SIZE=256

# Таймаут запросов к LLM
RC_HTTP_TIMEOUT=5m
